# LLM — OpenAI 호환 엔드포인트면 무엇이든 된다
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=your-key
LOCAL_MODEL=model-name

# 웹 검색 — https://tavily.com 무료 키
TAVILY_API_KEY=tvly-...

# 발송 대상 — 디스코드 채널 설정 > 연동 > 웹후크
# 여러 채널로 보내려면 쉼표로 나열한다
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 실행 추적 (선택) — https://smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=news-market-agent

# ── 로컬 전용 (.env.dev) ────────────────────────────────
# 같은 폴더에 .env.dev 를 두면 .env 위를 덮는다. CI 에서는 읽지 않는다.
# 시험 채널·캐시처럼 로컬에서만 다르게 둘 값을 여기 적는다.
#
#   DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...   시험 채널
#   SEARCH_CACHE=1
#   LANGSMITH_PROJECT=news-market-agent-dev
